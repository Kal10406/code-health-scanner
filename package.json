{
  "name": "baseline-cli",
  "version": "1.0.0",
  "description": "Tiny CLI that scans files for modern web feature usage and reports Baseline status (uses web-features).",
  "type": "module",
  "main": "check.js",
  "bin": {
    "baseline-check": "./check.js"
  },
  "scripts": {
    "start": "node server.js",
    "scan": "node check.js",
    "demo": "node check.js demo.html",
    "prepare-demo": "node check.js demo.html > demo-output.txt"
  },
  "keywords": [
    "baseline",
    "web-features",
    "compatibility",
    "cli",
    "hackathon"
  ],
  "author": "Kalpana",
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "web-features": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kal10406/baseline-cli.git"
  },
  "homepage": "https://github.com/Kal10406/baseline-cli",
  "engines": {
    "node": ">=18.0.0"
  }
}
